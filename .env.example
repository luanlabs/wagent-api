# ============================================================================
# Core configuration
# All of the variables in this section are REQUIRED — the app validates them on
# startup (see src/config/envs.ts) and refuses to start if any are missing.
# ============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development                  # development | production

# --- MongoDB ---
# Compose overrides this for the API container. For a host-run API using the
# Compose database, use mongodb://localhost:27016.
DB_URI=mongodb://localhost:27017
DB_NAME=wagent

# --- Auth ---
# Secret used to sign 30-day JWTs. Use a long, random value in production.
JWT_SECRET=change_me_to_a_long_random_secret
# Currently required by startup validation but not yet consumed anywhere in the
# code. Kept for backwards compatibility; safe to remove once envs.ts drops it.
ADMIN_PASSWORD=change_me

# --- Blux (server-side wallet verification) ---
# Public app id from the Blux dashboard. The interface uses the same value.
BLUX_APP_ID=ttaynetjysq6ko7fypb7
# Server secret from the Blux dashboard. Never expose this to the browser.
BLUX_APP_SECRET=blux_sk_bvmxq6ho7tjh9yqp2b7dmv0sgb2ltimg9a6ypb7yyr8otqbso84m

# --- Email (SMTP, sent via smtp.hostinger.com:587) ---
EMAIL_USER=no-reply@example.com
EMAIL_PASS=your_smtp_password

# --- External URLs ---
FRONTEND_URL=https://wagent.app       # used to build email links (verify/reset/unsubscribe)
PAYMENT_URL=https://pay.wagent.app    # base URL returned when an order is created
SWAGGER_API_URL=http://localhost:5000 # server URL advertised in the Swagger UI

# --- Logging (always stdout; production also writes to this file) ---
LOG_FILE_PATH=/var/log/wagent/api.log

# ============================================================================
# Optional
# ============================================================================

# Restrict CORS to a comma-separated allowlist of origins.
# When unset, all origins are allowed (the historical default).
# CORS_ORIGIN=https://wagent.app,https://pay.wagent.app

# ============================================================================
# Docker Compose only (consumed by compose.yaml)
# In compose, LOG_FILE_PATH is derived from LOG_FILENAME, and LOG_DIRNAME is
# mounted as the log directory.
# ============================================================================
# LOG_DIRNAME=./logs
# LOG_FILENAME=api.log
